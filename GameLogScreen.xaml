<Page
    x:Class="BaseballGameCreator.GameLogScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BaseballGameCreator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<!-- Keep the ScrollViewer but constrain the inside Grid to the page height
         so star row sizing (1/3/1) maps to 1/5, 3/5, 1/5 of the visible page. -->
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
		<Grid Height="{Binding ActualHeight, ElementName=rootPage}" Margin="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="1*"/>
				<!-- top 1/5 -->
				<RowDefinition Height="3*"/>
				<!-- middle 3/5 -->
				<RowDefinition Height="1*"/>
				<!-- bottom 1/5 -->
			</Grid.RowDefinitions>

			<!-- Top: title + extra notes -->
			<StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="8">
				<TextBlock Text="Game Log" FontSize="30" HorizontalAlignment="Left"/>
				<!-- keep your name extraNotesX; sized to fit the row -->
				<TextBox x:Name="extraNotesX"
                         Margin="0,8,0,0"
                         FontSize="18"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"/>
			</StackPanel>

			<!-- Middle: main game log box (fills the large middle area) -->
			<Grid Grid.Row="1" Margin="8,4">
				<TextBox x:Name="Finally"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
			</Grid>

			<!-- Bottom: save button and status -->
			<Grid Grid.Row="2" Margin="8" VerticalAlignment="Center">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="1"
                        x:Name="saveGameLogButton"
                        Height="44"
                        Width="300"
                        FontSize="18"
                        Content="SAVE GAME LOG"
                        Click="saveGameLog_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="Black"
                        BorderThickness="2"/>

				<TextBlock Grid.Column="2"
                           x:Name="saveStatus"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
			</Grid>
		</Grid>
	</ScrollViewer>
</Page>
